{
  "twitter_section": {
    "type": "object",
    "description": "推特账号与 Cookies 配置",
    "items": {
      "cookie_json": {
        "type": "string",
        "description": "Twitter Cookies (JSON 格式)",
        "hint": "请使用浏览器插件将 Twitter Cookies 导出为 JSON 格式并粘贴至此处",
        "editor_mode": true,
        "editor_language": "json",
        "default": "[]"
      },
      "proxy": {
        "type": "string",
        "description": "网络代理地址",
        "hint": "访问 Twitter 与 Gemini 所需的代理（例: http://127.0.0.1:7890）",
        "default": "http://127.0.0.1:7890"
      }
    }
  },
"gemini_section": {
    "type": "object",
    "description": "Gemini AI 配置",
    "items": {
      "gemini_api_key": {
        "type": "string",
        "description": "Gemini API Key (支持多 Key)",
        "hint": "填入 Gemini API Key。若有多个 Key 请用英文逗号或换行分隔，插件会自动轮询与失效切换",
        "default": ""
      },
      "model_name": {
        "type": "string",
        "description": "评估模型名称",
        "default": "gemini-3.1-flash-lite"
      },
      "score_threshold": {
        "type": "float",
        "description": "合格审美打分阈值 (1-10)",
        "default": 7.0
      }
    }
  },
  "filter_section": {
    "type": "object",
    "description": "WD14 粗筛标签配置",
    "items": {
      "wd14_threshold": {
        "type": "float",
        "description": "WD14 标签判定阈值",
        "default": 0.35
      },
      "whitelist_tags": {
        "type": "string",
        "description": "白名单标签（半角逗号分隔）",
        "default": "1girl, girls, multiple_girls, 2girls, 3girls, 4girls, 5girls, 6+girls, virtual_youtuber"
      },
      "must_reject_tags": {
        "type": "string",
        "description": "黑名单标签（半角逗号分隔）",
        "default": "screenshot, game_screenshot, 3d, realistic, 1boy, male_focus, text_focus, no_humans, tokusatsu"
      }
    }
  },
"storage_section": {
    "type": "object",
    "description": "本地文件与下载配置",
    "items": {
      "save_local": {
        "type": "bool",
        "description": "保存精选插画到本地",
        "hint": "开启后，精选通过的插画除了发送给用户外，还会持久化保存到 plugin_data/astrbot_plugin_twitanime/saved/ 目录",
        "default": false
      },
      "download_orig": {
        "type": "bool",
        "description": "强制抓取高清原图 (orig)",
        "hint": "开启后，将强制把推特图片链接替换为 name=orig 获取最高画质原图",
        "default": false
      }
    }
  }
}